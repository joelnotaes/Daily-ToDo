/* Kenvelo Daily Planner - login add-on.
   Adds a login screen, keeps you signed in, and sends your login token
   with every request to the tasks table. No changes to the app logic needed. */
(function () {
  var SB_URL = "https://xxrbbhrvrjjaobahvlaf.supabase.co";
  var SB_KEY = "sb_publishable_FkMIVN_l0KZy5k99B36ZVA_AJyUzhtl";
  var REST = SB_URL + "/rest/v1/";
  var SK = "kenvelo_session";
  var origFetch = window.fetch.bind(window);
  var session = null;
  try { session = JSON.parse(localStorage.getItem(SK) || "null"); } catch (e) {}

  var css = document.createElement("style");
  css.textContent =
    "#auth-overlay{position:fixed;inset:0;z-index:100;background:#fff;display:flex;align-items:center;justify-content:center;padding:24px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif}" +
    "#auth-form{display:flex;flex-direction:column;gap:10px;width:100%;max-width:360px}" +
    "#auth-form h2{margin:0 0 6px;font-size:18px;color:#1e293b;text-align:center}" +
    "#auth-form input{font-size:16px;padding:12px;border:1px solid #e2e8f0;border-radius:8px;outline:none;color:#1e293b}" +
    "#auth-form input:focus{border-color:#94a3b8}" +
    "#auth-in{padding:12px;border:none;border-radius:8px;background:#334155;color:#fff;font-size:15px;font-weight:600;cursor:pointer}" +
    "#auth-up{padding:12px;border:1px solid #e2e8f0;border-radius:8px;background:#fff;color:#334155;font-size:15px;cursor:pointer}" +
    "#auth-msg{margin:0;font-size:13px;color:#64748b;min-height:18px;text-align:center}" +
    "#auth-msg.err{color:#ef4444}" +
    "#auth-out{position:fixed;top:8px;right:max(12px,calc(50% - 212px));z-index:30;font-size:11px;color:#94a3b8;background:none;border:none;cursor:pointer}" +
    "#auth-out:hover{color:#334155}";
  document.head.appendChild(css);

  function save(s) {
    session = {
      access_token: s.access_token,
      refresh_token: s.refresh_token,
      expires_at: s.expires_at || Math.floor(Date.now() / 1000) + (s.expires_in || 3600)
    };
    localStorage.setItem(SK, JSON.stringify(session));
  }

  async function authReq(path, body) {
    var res = await origFetch(SB_URL + "/auth/v1/" + path, {
      method: "POST",
      headers: { "apikey": SB_KEY, "Content-Type": "application/json" },
      body: JSON.stringify(body)
    });
    var data = await res.json().catch(function () { return {}; });
    if (!res.ok) {
      var err = new Error(data.msg || data.error_description || data.message || "Something went wrong");
      err.status = res.status;
      throw err;
    }
    return data;
  }

  async function getToken() {
    if (!session) return null;
    if (session.expires_at - 60 > Math.floor(Date.now() / 1000)) return session.access_token;
    try {
      var d = await authReq("token?grant_type=refresh_token", { refresh_token: session.refresh_token });
      save(d);
      return session.access_token;
    } catch (e) {
      if (e.status) { session = null; localStorage.removeItem(SK); return null; }
      return session.access_token; // offline: keep old token, request will just fail
    }
  }

  // Attach the user's login token to every request to the tasks table
  window.fetch = async function (input, init) {
    var url = typeof input === "string" ? input : input.url;
    if (url.indexOf(REST) === 0) {
      var token = await getToken();
      if (!token) { showLogin(); throw new Error("not signed in"); }
      init = Object.assign({}, init, {
        headers: Object.assign({}, init && init.headers, { "Authorization": "Bearer " + token })
      });
    }
    return origFetch(input, init);
  };

  function msg(t, isErr) {
    var m = document.getElementById("auth-msg");
    m.textContent = t;
    m.className = isErr ? "err" : "";
  }

  function showLogin() {
    if (document.getElementById("auth-overlay")) return;
    var o = document.createElement("div");
    o.id = "auth-overlay";
    o.innerHTML =
      '<form id="auth-form"><h2>Kenvelo Daily Planner</h2>' +
      '<input id="auth-email" type="email" placeholder="Email" autocomplete="email" required>' +
      '<input id="auth-pass" type="password" placeholder="Password (min 6 characters)" autocomplete="current-password" minlength="6" required>' +
      '<button type="submit" id="auth-in">Sign in</button>' +
      '<button type="button" id="auth-up">Create account</button>' +
      '<p id="auth-msg"></p></form>';
    document.body.appendChild(o);
    var email = o.querySelector("#auth-email"), pass = o.querySelector("#auth-pass");

    async function go(mode) {
      msg("Please wait…");
      try {
        var creds = { email: email.value.trim(), password: pass.value };
        var d;
        if (mode === "up") {
          d = await authReq("signup", creds);
          if (!d.access_token) { msg("Check your email to confirm your account, then sign in."); return; }
        } else {
          d = await authReq("token?grant_type=password", creds);
        }
        save(d);
        location.reload();
      } catch (e) { msg(e.message, true); }
    }
    o.querySelector("#auth-form").addEventListener("submit", function (e) { e.preventDefault(); go("in"); });
    o.querySelector("#auth-up").addEventListener("click", function () { go("up"); });
  }

  function addLogout() {
    var b = document.createElement("button");
    b.id = "auth-out";
    b.textContent = "Log out";
    b.addEventListener("click", function () {
      b.textContent = "Saving…";
      setTimeout(function () { localStorage.removeItem(SK); location.reload(); }, 800);
    });
    document.body.appendChild(b);
  }

  if (session) addLogout(); else showLogin();
})();
